<?xml version="1.0"?>
<!--
license:CC0-1.0

Falgas Micro-87 front panel: the five status LEDs plus FAIL, laid out and
labelled as on the real metal panel.  Knobs, selector, buttons, lamps and the
motor will be added in later iterations.
-->
<mamelayout version="2">

	<!-- a single red LED -->
	<element name="led" defstate="0">
		<disk state="0">
			<color red="0.20" green="0.04" blue="0.04" />
		</disk>
		<disk state="1">
			<color red="1.00" green="0.22" blue="0.18" />
		</disk>
	</element>

	<element name="panel">
		<rect>
			<color red="0.10" green="0.11" blue="0.13" />
		</rect>
	</element>

	<element name="title">
		<text string="FALGAS MICRO-87 - 9187B">
			<color red="0.70" green="0.70" blue="0.74" />
		</text>
	</element>

	<element name="lbl_motor">
		<text string="MOTOR ON"><color red="0.90" green="0.90" blue="0.90" /></text>
	</element>
	<element name="lbl_coin">
		<text string="COIN INPUT"><color red="0.90" green="0.90" blue="0.90" /></text>
	</element>
	<element name="lbl_sound">
		<text string="SOUND"><color red="0.90" green="0.90" blue="0.90" /></text>
	</element>
	<element name="lbl_timer">
		<text string="TIMER"><color red="0.90" green="0.90" blue="0.90" /></text>
	</element>
	<element name="lbl_light">
		<text string="LIGHT"><color red="0.90" green="0.90" blue="0.90" /></text>
	</element>
	<element name="lbl_fail">
		<text string="FAIL"><color red="0.90" green="0.90" blue="0.90" /></text>
	</element>

	<view name="Control Panel">
		<bounds left="0" top="0" right="340" bottom="110" />

		<element ref="panel">
			<bounds left="0" top="0" right="340" bottom="110" />
		</element>
		<element ref="title">
			<bounds left="10" top="8" right="150" bottom="22" />
		</element>

		<!-- LED 0: motor on -->
		<element name="led0" ref="led">
			<bounds left="34" top="44" right="54" bottom="64" />
		</element>
		<element ref="lbl_motor">
			<bounds left="8" top="72" right="80" bottom="84" />
		</element>

		<!-- LED 1: coin input -->
		<element name="led1" ref="led">
			<bounds left="98" top="44" right="118" bottom="64" />
		</element>
		<element ref="lbl_coin">
			<bounds left="72" top="72" right="144" bottom="84" />
		</element>

		<!-- LED 2: sound -->
		<element name="led2" ref="led">
			<bounds left="162" top="44" right="182" bottom="64" />
		</element>
		<element ref="lbl_sound">
			<bounds left="136" top="72" right="208" bottom="84" />
		</element>

		<!-- LED 3: timer -->
		<element name="led3" ref="led">
			<bounds left="226" top="44" right="246" bottom="64" />
		</element>
		<element ref="lbl_timer">
			<bounds left="200" top="72" right="272" bottom="84" />
		</element>

		<!-- LED 4: light -->
		<element name="led4" ref="led">
			<bounds left="290" top="44" right="310" bottom="64" />
		</element>
		<element ref="lbl_light">
			<bounds left="264" top="72" right="336" bottom="84" />
		</element>

		<!-- FAIL, set apart on the real panel; not driven yet -->
		<element name="led5" ref="led">
			<bounds left="290" top="10" right="310" bottom="30" />
		</element>
		<element ref="lbl_fail">
			<bounds left="232" top="15" right="284" bottom="27" />
		</element>
	</view>

</mamelayout>
