<?xml version="1.0"?>
<!--
license:CC0-1.0
-->

<!-- ETRA crosswalk traffic light controller -->

<mamelayout version="2">

	<!-- traffic light lamps (state 1 = lamp lit) -->

	<element name="lamp_red" defstate="0">
		<disk><color red="0.02" green="0.02" blue="0.02" /></disk>
		<disk state="0"><bounds x="0.06" y="0.06" width="0.88" height="0.88" /><color red="0.22" green="0.04" blue="0.03" /></disk>
		<disk state="1"><bounds x="0.06" y="0.06" width="0.88" height="0.88" /><color red="1.00" green="0.13" blue="0.08" /></disk>
		<disk state="1"><bounds x="0.22" y="0.18" width="0.34" height="0.28" /><color red="1.00" green="0.55" blue="0.45" alpha="0.6" /></disk>
	</element>

	<element name="lamp_amber" defstate="0">
		<disk><color red="0.02" green="0.02" blue="0.02" /></disk>
		<disk state="0"><bounds x="0.06" y="0.06" width="0.88" height="0.88" /><color red="0.23" green="0.14" blue="0.02" /></disk>
		<disk state="1"><bounds x="0.06" y="0.06" width="0.88" height="0.88" /><color red="1.00" green="0.68" blue="0.05" /></disk>
		<disk state="1"><bounds x="0.22" y="0.18" width="0.34" height="0.28" /><color red="1.00" green="0.90" blue="0.55" alpha="0.6" /></disk>
	</element>

	<element name="lamp_green" defstate="0">
		<disk><color red="0.02" green="0.02" blue="0.02" /></disk>
		<disk state="0"><bounds x="0.06" y="0.06" width="0.88" height="0.88" /><color red="0.02" green="0.17" blue="0.10" /></disk>
		<disk state="1"><bounds x="0.06" y="0.06" width="0.88" height="0.88" /><color red="0.10" green="1.00" blue="0.55" /></disk>
		<disk state="1"><bounds x="0.22" y="0.18" width="0.34" height="0.28" /><color red="0.65" green="1.00" blue="0.85" alpha="0.6" /></disk>
	</element>

	<element name="housing">
		<rect><bounds x="0" y="0" width="84" height="240" /><color red="0.09" green="0.09" blue="0.09" /></rect>
		<rect><bounds x="3" y="3" width="78" height="234" /><color red="0.15" green="0.15" blue="0.15" /></rect>
	</element>

	<element name="pole"><rect><color red="0.35" green="0.36" blue="0.38" /></rect></element>

	<!-- programming interface -->

	<element name="digit" defstate="0">
		<led7seg><color red="1.0" green="0.15" blue="0.08" /></led7seg>
	</element>

	<element name="panel"><rect><color red="0.12" green="0.13" blue="0.15" /></rect></element>
	<element name="bezel"><rect><color red="0.02" green="0.02" blue="0.02" /></rect></element>
	<element name="pedbox"><rect><color red="0.85" green="0.68" blue="0.08" /></rect></element>

	<element name="key" defstate="0">
		<rect><bounds x="0" y="0" width="64" height="56" /><color red="0.06" green="0.06" blue="0.06" /></rect>
		<rect state="0"><bounds x="3" y="3" width="58" height="50" /><color red="0.33" green="0.34" blue="0.32" /></rect>
		<rect state="1"><bounds x="3" y="3" width="58" height="50" /><color red="0.56" green="0.57" blue="0.54" /></rect>
	</element>

	<element name="button" defstate="0">
		<disk><bounds x="0" y="0" width="40" height="40" /><color red="0.05" green="0.05" blue="0.05" /></disk>
		<disk state="0"><bounds x="5" y="5" width="30" height="30" /><color red="0.62" green="0.62" blue="0.66" /></disk>
		<disk state="1"><bounds x="5" y="5" width="30" height="30" /><color red="0.95" green="0.95" blue="1.00" /></disk>
	</element>

	<!-- toggle switch: lever down in the default position, up when toggled -->
	<element name="toggle" defstate="0">
		<rect><bounds x="0" y="0" width="28" height="56" /><color red="0.05" green="0.05" blue="0.05" /></rect>
		<disk><bounds x="4" y="18" width="20" height="20" /><color red="0.55" green="0.55" blue="0.58" /></disk>
		<rect state="0"><bounds x="11" y="28" width="6" height="20" /><color red="0.85" green="0.85" blue="0.88" /></rect>
		<disk state="0"><bounds x="8" y="44" width="12" height="12" /><color red="0.85" green="0.85" blue="0.88" /></disk>
		<rect state="1"><bounds x="11" y="8" width="6" height="20" /><color red="0.85" green="0.85" blue="0.88" /></rect>
		<disk state="1"><bounds x="8" y="0" width="12" height="12" /><color red="0.85" green="0.85" blue="0.88" /></disk>
	</element>

	<element name="led_sync" defstate="0">
		<disk><color red="0.05" green="0.05" blue="0.05" /></disk>
		<disk state="0"><bounds x="0.15" y="0.15" width="0.7" height="0.7" /><color red="0.15" green="0.12" blue="0.02" /></disk>
		<disk state="1"><bounds x="0.15" y="0.15" width="0.7" height="0.7" /><color red="1.00" green="0.85" blue="0.10" /></disk>
	</element>

	<!-- key legends -->
	<element name="k_R"><text string="R"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_M"><text string="M"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_N"><text string="N"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_K"><text string="K"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_A"><text string="A"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_B"><text string="B"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_C"><text string="C"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_D"><text string="D"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_E"><text string="E"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_F"><text string="F"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<repeat count="10">
		<param name="n" start="0" increment="1" />
		<element name="k_~n~"><text string="~n~"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	</repeat>

	<!-- other text -->
	<element name="t_step"><text string="STEP" align="1"><color red="0.85" green="0.85" blue="0.85" /></text></element>
	<element name="t_flash"><text string="FLASHING" align="1"><color red="0.85" green="0.85" blue="0.85" /></text></element>
	<element name="t_manual"><text string="MANUAL" align="1"><color red="0.85" green="0.85" blue="0.85" /></text></element>
	<element name="t_extprg"><text string="EXT. PROG." align="1"><color red="0.85" green="0.85" blue="0.85" /></text></element>
	<element name="t_inputs"><text string="EXTERNAL INPUTS / OUTPUT" align="1"><color red="0.60" green="0.62" blue="0.66" /></text></element>
	<element name="t_syncin"><text string="SYNC IN" align="1"><color red="0.85" green="0.85" blue="0.85" /></text></element>
	<element name="t_prg0"><text string="PROG 0" align="1"><color red="0.85" green="0.85" blue="0.85" /></text></element>
	<element name="t_prg1"><text string="PROG 1" align="1"><color red="0.85" green="0.85" blue="0.85" /></text></element>
	<element name="t_syncout"><text string="SYNC OUT" align="1"><color red="0.85" green="0.85" blue="0.85" /></text></element>
	<element name="t_push"><text string="PUSH"><color red="0.05" green="0.05" blue="0.05" /></text></element>
	<element name="t_pedestrian"><text string="PEDESTRIAN"><color red="0.05" green="0.05" blue="0.05" /></text></element>
	<repeat count="3">
		<param name="b" start="1" increment="1" />
		<element name="t_board~b~_0"><text string="BOARD ~b~ A"><color red="0.85" green="0.85" blue="0.85" /></text></element>
		<element name="t_board~b~_1"><text string="BOARD ~b~ B"><color red="0.85" green="0.85" blue="0.85" /></text></element>
	</repeat>

	<!-- six digit display, digit 0 on the left -->
	<group name="display">
		<element ref="bezel"><bounds x="0" y="0" width="420" height="104" /></element>
		<repeat count="6">
			<param name="d" start="0" increment="1" />
			<param name="x" start="14" increment="66" />
			<element name="digit~d~" ref="digit"><bounds x="~x~" y="10" width="56" height="84" /></element>
		</repeat>
	</group>

	<!-- one lamp group of a relay board: bits ~r~/~a~/~g~ of board ~b~ -->
	<group name="relay_head">
		<element ref="t_board~b~_~grp~"><bounds x="0" y="0" width="84" height="16" /></element>
		<element ref="housing"><bounds x="0" y="28" width="84" height="240" /></element>
		<element name="lamp~b~_~r~" ref="lamp_red"><bounds x="10" y="38" width="64" height="64" /></element>
		<element name="lamp~b~_~a~" ref="lamp_amber"><bounds x="10" y="116" width="64" height="64" /></element>
		<element name="lamp~b~_~g~" ref="lamp_green"><bounds x="10" y="194" width="64" height="64" /></element>
	</group>

	<view name="Controller">
		<bounds left="0" top="0" right="680" bottom="620" />

		<!-- traffic light driven by relay board 1 (A004), bits 0-2 -->
		<element ref="pole"><bounds x="85" y="440" width="20" height="160" /></element>
		<element ref="housing"><bounds x="20" y="20" width="150" height="420" /></element>
		<element name="lamp1_0" ref="lamp_red"><bounds x="35" y="35" width="120" height="120" /></element>
		<element name="lamp1_1" ref="lamp_amber"><bounds x="35" y="170" width="120" height="120" /></element>
		<element name="lamp1_2" ref="lamp_green"><bounds x="35" y="305" width="120" height="120" /></element>

		<!-- pedestrian push button box -->
		<element ref="pedbox"><bounds x="50" y="470" width="90" height="100" /></element>
		<element ref="t_pedestrian"><bounds x="55" y="478" width="80" height="14" /></element>
		<element ref="button" inputtag="SW0" inputmask="0x04"><bounds x="70" y="498" width="50" height="50" /></element>
		<element ref="t_push"><bounds x="70" y="550" width="50" height="14" /></element>

		<!-- programmer panel -->
		<element ref="panel"><bounds x="200" y="20" width="460" height="460" /></element>
		<group ref="display"><bounds x="220" y="40" width="420" height="104" /></group>

		<repeat count="5">
			<param name="row" start="4" increment="-1" />
			<param name="y" start="164" increment="62" />
			<repeat count="4">
				<param name="mask" start="0x01" lshift="1" />
				<param name="x" start="220" increment="76" />
				<element ref="key" inputtag="KEY~row~" inputmask="~mask~"><bounds x="~x~" y="~y~" width="64" height="56" /></element>
			</repeat>
		</repeat>

		<element ref="k_R"><bounds x="236" y="176" width="32" height="32" /></element>
		<element ref="k_M"><bounds x="312" y="176" width="32" height="32" /></element>
		<element ref="k_N"><bounds x="388" y="176" width="32" height="32" /></element>
		<element ref="k_K"><bounds x="464" y="176" width="32" height="32" /></element>
		<element ref="k_0"><bounds x="236" y="238" width="32" height="32" /></element>
		<element ref="k_1"><bounds x="312" y="238" width="32" height="32" /></element>
		<element ref="k_2"><bounds x="388" y="238" width="32" height="32" /></element>
		<element ref="k_3"><bounds x="464" y="238" width="32" height="32" /></element>
		<element ref="k_4"><bounds x="236" y="300" width="32" height="32" /></element>
		<element ref="k_5"><bounds x="312" y="300" width="32" height="32" /></element>
		<element ref="k_6"><bounds x="388" y="300" width="32" height="32" /></element>
		<element ref="k_7"><bounds x="464" y="300" width="32" height="32" /></element>
		<element ref="k_8"><bounds x="236" y="362" width="32" height="32" /></element>
		<element ref="k_9"><bounds x="312" y="362" width="32" height="32" /></element>
		<element ref="k_A"><bounds x="388" y="362" width="32" height="32" /></element>
		<element ref="k_B"><bounds x="464" y="362" width="32" height="32" /></element>
		<element ref="k_C"><bounds x="236" y="424" width="32" height="32" /></element>
		<element ref="k_D"><bounds x="312" y="424" width="32" height="32" /></element>
		<element ref="k_E"><bounds x="388" y="424" width="32" height="32" /></element>
		<element ref="k_F"><bounds x="464" y="424" width="32" height="32" /></element>

		<!-- front panel switches (which physical switch is which is not verified) -->
		<element ref="button" inputtag="SW2" inputmask="0x02"><bounds x="532" y="172" width="40" height="40" /></element>
		<element ref="t_step"><bounds x="580" y="184" width="72" height="16" /></element>
		<element ref="toggle" inputtag="SW1" inputmask="0x01"><bounds x="538" y="288" width="28" height="56" /></element>
		<element ref="t_flash"><bounds x="580" y="308" width="72" height="16" /></element>
		<element ref="toggle" inputtag="SW1" inputmask="0x02"><bounds x="538" y="350" width="28" height="56" /></element>
		<element ref="t_manual"><bounds x="580" y="370" width="72" height="16" /></element>
		<element ref="toggle" inputtag="SW1" inputmask="0x04"><bounds x="538" y="412" width="28" height="56" /></element>
		<element ref="t_extprg"><bounds x="580" y="432" width="72" height="16" /></element>

		<!-- optocoupler inputs and synchronisation output -->
		<element ref="panel"><bounds x="200" y="500" width="460" height="100" /></element>
		<element ref="t_inputs"><bounds x="212" y="508" width="300" height="14" /></element>
		<element ref="button" inputtag="SW2" inputmask="0x01"><bounds x="214" y="536" width="44" height="44" /></element>
		<element ref="t_syncin"><bounds x="264" y="551" width="70" height="14" /></element>
		<element ref="toggle" inputtag="SW0" inputmask="0x01"><bounds x="340" y="530" width="28" height="56" /></element>
		<element ref="t_prg0"><bounds x="374" y="551" width="60" height="14" /></element>
		<element ref="toggle" inputtag="SW0" inputmask="0x02"><bounds x="440" y="530" width="28" height="56" /></element>
		<element ref="t_prg1"><bounds x="474" y="551" width="60" height="14" /></element>
		<element name="sync_out" ref="led_sync"><bounds x="540" y="546" width="24" height="24" /></element>
		<element ref="t_syncout"><bounds x="570" y="551" width="80" height="14" /></element>
	</view>

	<view name="Relay Boards">
		<bounds left="0" top="0" right="804" bottom="438" />

		<group ref="display"><bounds x="192" y="20" width="420" height="104" /></group>
		<repeat count="3">
			<param name="b" start="1" increment="1" />
			<param name="bx" start="20" increment="280" />
			<repeat count="2">
				<param name="grp" start="0" increment="1" />
				<param name="r" start="0" increment="4" />
				<param name="a" start="1" increment="4" />
				<param name="g" start="2" increment="4" />
				<param name="x" start="~bx~" increment="120" />
				<group ref="relay_head"><bounds x="~x~" y="150" width="84" height="268" /></group>
			</repeat>
		</repeat>
	</view>

</mamelayout>
